{
  "name": "pocket-term",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pocket-stack/pocket-term.git"
  },
  "scripts": {
    "setup": "git submodule update --init && bun install --cwd vendor/pocketjs && bun scripts/setup.ts",
    "3ds": "bun scripts/3ds.ts",
    "pair": "bun scripts/pair.ts",
    "mirror": "bun scripts/mirror.ts",
    "daemon": "node --experimental-transform-types host/serve.ts",
    "push": "bun scripts/push.ts",
    "probe": "bun scripts/probe.ts",
    "typecheck": "bun vendor/pocketjs/node_modules/typescript/bin/tsc --noEmit && bun vendor/pocketjs/node_modules/typescript/bin/tsc --noEmit -p host/tsconfig.json",
    "test": "bun test --conditions=browser test/host.test.ts test/exchange.test.ts test/store.test.ts test/layout.test.ts test/history.test.ts test/history-batch.test.ts test/prediction.test.ts test/latency.test.ts test/transport.test.ts test/relay.test.ts test/relay-journal.test.ts test/relay-transport.test.ts",
    "check": "bun scripts/check.ts",
    "font": "bun scripts/font.ts",
    "bench:relay": "bun --conditions=browser scripts/relay-bench.ts",
    "test:pty": "node --experimental-transform-types --test test/pty.integration.ts test/ghostty-history.integration.ts test/relay-pty.integration.ts",
    "visual": "bun scripts/visual.ts",
    "deploy": "bun scripts/deploy.ts"
  }
}
